{
  "name": "marosim",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "description": "Mobile-first Marosim catalog and request platform for event services, goods, and equipment.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node scripts/generate-pwa-icons.mjs",
